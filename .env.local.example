# Server-only OpenWeather credential for live conditions and forecasts.
OPENWEATHER_API_KEY=

# Supabase project connection. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential for cron ingestion and hourly rollups.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer secret required by /api/cron/fetch-weather.
CRON_SECRET=
